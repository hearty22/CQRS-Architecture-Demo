// ==========================================================
// CQRS - LADO DE ESCRITURA (PostgreSQL)
// Fuente de verdad: agregados + outbox transaccional.
// ==========================================================
//
// NOTA Prisma 7: el bloque `datasource` ya NO lleva `url`.
// La conexión se define en prisma7.config.ts.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  // Con moduleResolution "NodeNext" los imports relativos
  // necesitan extensión explícita (.js) para resolver en runtime.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// --------------------------------------------------------------
// Order - Write Model
//
// Side de escritura UNICO. Nunca se lee para responder queries:
// las lecturas van a los read models de MongoDB (src/queries).
//
// price es Decimal -> numeric(12,2). Un importe en float acumula
// error de punto flotante (19.99 -> 19.989999999999998).
// --------------------------------------------------------------
model Order {
  id          String   @id @default(uuid()) @db.Uuid
  productName String   @db.VarChar(255)
  price       Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("orders")
}

// --------------------------------------------------------------
// Outbox transaccional
//
// Es la pieza que hace que el CQRS sea correcto. Redis Pub/Sub
// es fire-and-forget: si el worker o los suscriptores estan caidos
// los eventos se pierden en silencio y los read models de MongoDB
// divergen del write model de Postgres.
//
// El relay escribe el agregado y esta fila en la MISMA transaccion.
// El evento se publica a Redis solo despues del commit.
//
// Optimizacion pendiente: reemplazar este indice por uno parcial
//   CREATE INDEX outbox_pending ON outbox (occurred_at)
//     WHERE published_at IS NULL;
// Prisma no soporta indices parciales de forma declarativa.
// --------------------------------------------------------------
model Outbox {
  id            String    @id @default(uuid()) @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(255)
  aggregateId   String    @map("aggregate_id") @db.VarChar(255)
  eventType     String    @map("event_type") @db.VarChar(255)
  channel       String    @db.VarChar(255)
  payload       Json
  metadata      Json?

  occurredAt  DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)

  attempts  Int     @default(0)
  lastError String? @map("last_error") @db.Text

  // Soporta el ORDER BY del relay: WHERE published_at IS NULL ORDER BY occurred_at
  @@index([publishedAt, occurredAt], map: "outbox_pending_idx")
  @@index([aggregateType, aggregateId], map: "outbox_aggregate_idx")
  @@map("outbox")
}
