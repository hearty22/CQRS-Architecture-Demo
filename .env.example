# ==========================================
# CQRS API - Variables de entorno
# Copiá este archivo a .env y ajustá los valores.
#
# Este archivo lo lee docker-compose para interpolar valores y para
# publicar puertos en el HOST. Los puertos de red INTERNO de cada
# servicio los fija docker-compose.yml (5432, 27017, 6379) y no se
# tocan acá.
# ==========================================

NODE_ENV=development
LOG_LEVEL=debug

# Puertos publicados en el host.
# 5432/27017/6379 ya estan ocupados por servicios locales, por eso el
# desfasaje. Si tenés esos puertos libres, poné los estandar.
PORT=3000
FRONTEND_PORT=5173
POSTGRES_PUBLISHED_PORT=5433
MONGO_PUBLISHED_PORT=27018
REDIS_PUBLISHED_PORT=6380

# ----------------------------------------------------
# Credenciales. Las usa compose para los datastores y las
# pasa al backend. Dentro de la red de compose los hosts
# son los nombres de servicio (postgres/mongodb/redis).
# ----------------------------------------------------
POSTGRES_USER=cqrs
POSTGRES_PASSWORD=cqrs_password
POSTGRES_DB=cqrs

MONGO_USER=cqrs
MONGO_PASSWORD=cqrs_password
MONGO_DB=cqrs

REDIS_PASSWORD=cqrs_redis_password
